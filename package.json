{
  "name": "magicshell",
  "version": "0.9.0",
  "description": "分组式 PowerShell 终端工作台（每个终端独立配色/标题/启动目录 · 目录历史逐级回退 · 可收起可拖宽的侧边栏 · 分组平铺 · 复制全部 · 分组置顶）",
  "main": "src/main.js",
  "author": "fire988",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "node tools/package.mjs",
    "dist": "electron-builder --win portable -c.npmRebuild=false",
    "dist:dir": "electron-builder --win --dir -c.npmRebuild=false"
  },
  "build": {
    "appId": "com.magicshell.terminal",
    "productName": "MagicShell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,__tests__,tests,example,examples,docs,*.md,*.ts,*.map}",
      "!tools/**/*",
      "!docs/**/*",
      "!.tmp/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MagicShell-${version}.exe"
    },
    "portable": {
      "artifactName": "MagicShell-${version}.exe"
    },
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  }
}
